\long\def\dont#1{}

% The following is used for e.g., theorem numbers,
% figure numbers, etc.. The subsubnumbox (say that
% ten times fast) outputs
% (section num).(subsection num).(subsub num),
% omitting (section num) or (subsection num) if
% they are zero
\newcount\subsubnum
\subsubnum=0
\def\subsubnums{%
    \global\advance\subsubnum by 1
    \ifnum\the\sectnum=0{}\else{\the\sectnum.}\fi%
    \ifnum\the\subsectnum=0{}\else{\the\subsectnum.}\fi%
    \the\subsubnum}
\def\passivesubsubnums{%
    %Does the same without advancing
    \ifnum\the\sectnum=0{}\else{\the\sectnum.}\fi%
    \ifnum\the\subsectnum=0{}\else{\the\subsectnum.}\fi%
    \the\subsubnum}

\newcount\fignum
\fignum=0
\def\fignums{%
    \global\advance\fignum by 1
    \ifnum\the\sectnum=0{}\else{\the\sectnum.}\fi%
    \ifnum\the\subsectnum=0{}\else{\the\subsectnum.}\fi%
    \the\fignum}
\def\passivefignums{%
    %Does the same without advancing
    \ifnum\the\sectnum=0{}\else{\the\sectnum.}\fi%
    \ifnum\the\subsectnum=0{}\else{\the\subsectnum.}\fi%
    \the\fignum}

\long\def\nonumfigure#1#2{%
\vbox{
        \vskip\parskip
        \vskip 1em
        \centerline{\hskip\leftskip\vbox{#1}}%
        \vskip0em
        \centerline{\hskip\leftskip#2}%
        \vskip\parskip
}        
}    

\long\def\nonumpdffig#1#2{%
        \saveimageresource{#1}%
        \nonumfigure{\useimageresource\lastsavedimageresourceindex}{#2}
}

\def\figureword{Figure}
\long\def\figure#1#2#3{%
\nonumfigure{#1}{Figure \fignums: #3}
\definexref{#2}{\passivefignums}{figure}
}

\long\def\pdffigure#1#2#3{%
      \saveimageresource{#1}%
      \figure{\useimageresource\lastsavedimageresourceindex}{#2}{#3}
}

\newcount\tblnum
\tblnum=0
\def\tblnums{%
    \global\advance\tblnum by 1
    \ifnum\the\sectnum=0{}\else{\the\sectnum.}\fi%
    \ifnum\the\subsectnum=0{}\else{\the\subsectnum.}\fi%
    \the\tblnum}
\def\passivetblnums{%
    %Does the same without advancing
    \ifnum\the\sectnum=0{}\else{\the\sectnum.}\fi%
    \ifnum\the\subsectnum=0{}\else{\the\subsectnum.}\fi%
    \the\tblnum}

\def\tableword{Table}
\long\def\table#1#2#3{%
\nonumfigure{{\offinterlineskip
              \halign{%
              #1
              }}}{Table \tblnums: #3}
\definexref{#2}{\passivetblnums}{table}}              


\long\def\quote
#1
---#2
{%
  \vskip\the\parskip
  {\leftskip 2in plus 1fill\it
    #1\par
  \smallvskip
    \hfill\rm---{\thinspace}#2\par
  }}

\def\unorderedmarker{$\bullet$}
