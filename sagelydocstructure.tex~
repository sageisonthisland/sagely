% Markers for  lists

% Sectioning
\def\header#1{{\ss
  \line{\hfill#1}%
  \line{\hfill\the\day\ \fullmonthname\ \the\year}%
  \line{\hfill Sage Mitchell}}%
}

\def\title#1{%
  \vskip\parskip
  \centerline{\titlefont\relax#1}
}

\def\subtitle#1{%
  \vskip1.5\parskip
  \centerline{\subtitlefont\relax#1}
  \vskip.25em
}

\newcount\sectnum
\newcount\subsectnum
\sectnum=0
\subsectnum=0

\def\nonumsection#1{%
  \subsectnum=0%
  \subsubnum=0%
  \fignum=0%
  \vskip\parskip
  \vskip\parskip
  \line{\sectionfont\relax#1\hfill}%
}

\def\nonumsubsection#1{%
  \subsubnum=0%
  \fignum=0%
  \vskip\parskip
  \vskip\parskip
  \line{\subtitlefont\relax#1\hfill}
}

\def\sectionword{Section}
\def\section#1{%
  \subsectnum=0%
  \advance\sectnum by 1%
  \definexref{#1}{\the\sectnum}{section}%
  \writenumberedtocentry{section}{#1}{\the\sectnum}
  \nonumsection{\the\sectnum. #1}
}

\def\subsectionword{Section}
\def\subsection#1{%
  \advance\subsectnum by 1%
  \definexref{#1}{\the\sectnum.\the\subsectnum}{subsection}%
  \writenumberedtocentry{subsection}{#1}{\the\subsectnum}%
  \nonumsubsection{\the\sectnum.\the\subsectnum. #1}%
}

\def\newpage{\relax\vfill\eject}

% Table of Contents
\def\tocsectionentry#1#2#3{\line{#2. #1\dotfill#3}\vskip.5em}
\def\tocsubsectionentry#1#2#3{\line{\hskip2em#2. #1\dotfill#3}\vskip.5em}

