\input eplain
\input smathfonts
\rm

% Dimensions
\nopagenumbers
\hsize 5in
\hoffset 0.75in
\vsize 8.5in
\voffset 0in
\pdfpagewidth 8.5in
\pdfpageheight 11in
\parindent 0pt
\parskip .75em
\baselineskip 1.4em
\def\smallvskip{\vskip-\parskip\vskip0.5em}

% Internal things
\def\monthname#1{%
\ifcase#1
\or January%
\or February%
\or March%
\or April%
\or May%
\or June%
\or July%
\or August%
\or September%
\or November%
\or December\fi}


% Sets and other symbols
\def\R{{\bbb R}}
\def\N{{\bbb N}}
\def\Z{{\bbb Z}}
\def\Q{{\bbb Q}}
\def\T{{\bbb T}}
\def\C{{\bbb C}}
%\let\emptyset\varnothing % Bye-bye ugly zero
\let\epsilon\varepsilon % Bye-bye not-very-mathy epsilon
\def\neq{\not\kern-.25pt=} % Fonts should be fixed now?
\def\neq{%
  \mathchoice
  {\kern.4pt\not\kern-.4pt=}
  {\kern.4pt\not\kern-.4pt=}
  {\kern1pt\not\kern-1pt=}
  {\kern1pt\not\kern-1pt=}}

% Functions
\def\mathfunc#1{\expandafter\def\csname #1\endcsname{\mathop{\rm\relax#1}}}
\mathfunc{ker}
\mathfunc{img}
\mathfunc{sup}
\mathfunc{inf}
\mathfunc{ord}
\def\fractional{\mathop{\rm frac}}

% Symbols / operators
\def\inv{^{-1}}
\def\of{\circ}
\def\implies{\Longrightarrow}
\def\defeq{\mathrel{\buildrel\Delta\over=}}
%\def\qed{\hfill$\square$}
\def\qed{\hfill\vbox{\hrule width .5em height .5em depth 0em}}

\let\oldfrac\frac
\def\frac #1/#2{\hbox{\oldfrac #1/#2}}

% Calculus
\def\diff{{\rm d}}
\def\d/d#1{{\diff\over\diff#1}}
\def\integral from #1 to #2 of #3 d#4{%
\int_{#1}^{#2} #3 \,\diff #4%
}


% Sectioning
\def\header#1{{\ss
\line{\hfill#1}%
\line{\hfill\the\day\ \fullmonthname\ \the\year}%
\line{\hfill Sage Mitchell}}%
}

\def\section#1{%
  \vskip\parskip
  \vskip\parskip
  \line{\sectionfont#1\hfill}
}

\def\newpage{\relax\vfill\eject}

% Little sections
\def\inset#1{{\ss\relax#1}}
\newskip\insetleftskip
\newskip\insetrightskip
\insetleftskip=4em
\insetrightskip=4em

\def\proof{%
  \par
  \inset{Proof.}\vskip-\parskip
  \begingroup
  \leftskip=\the\insetleftskip
  \rightskip=\the\insetrightskip
  \vskip-\baselineskip
}
\def\endproof{%
  \qed\par
  \endgroup
  }

\def\defn#1{
  \par
  \begingroup
  \leftskip=\the\insetleftskip
  \rightskip=\the\insetrightskip
  \inset{Definition. \ssbf#1}\vskip-\parskip}
\def\enddefn{
  \par\endgroup\vskip\parskip}
  
\def\proposition#1{%
  \par
  \inset{Proposition. \rm\relax#1}
  \par
}

\def\lemma#1{%
  \par
  \inset{Lemma. \rm\relax#1}
  \par
}  

\def\problem#1{%
\itemitem{\ss\relax#1}
}

\def\case#1{[{\it\relax#1}]}
\newbox\casebox
\def\newcase#1{%
  \setbox\casebox=\hbox to 5em plus 1fill{[{\it\relax#1}]}
  \box\casebox
}

\let\oldeqno\eqno
\def\eqno#1{\oldeqno{#1\relax\hskip\the\rightskip}}

\long\def\quote
#1
---#2
{%
  \vskip\the\parskip
  {\leftskip 2in plus 1fill\it
    #1\par
  \smallvskip
    \hfill\rm---{\thinspace}#2\par
  }}  